{
  "version": 2,
  "redirects": [
    {
      "source": "/:path*",
      "destination": "https://www.gshaftmaster.com/:path*",
      "permanent": true,
      "has": [
        {
          "type": "host",
          "value": "gshaftmaster.com"
        }
      ]
    }
  ],

  "headers": [
    {
      "source": "/(.*)\\.(jpg|jpeg|png|gif|ico|webp|svg|css|js)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],

  "rewrites": [
    { "source": "/guides", "destination": "/guides.html" },
    { "source": "/news",   "destination": "/news.html" },
    { "source": "/reviews","destination": "/reviews.html" }
  ],

  "trailingSlash": false,
  "cleanUrls": true
}